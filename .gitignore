# ── Secrets ──────────────────────────────────────────────────────────────────
# Real settings live only in local .env files; the *.example templates are committed.
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example
*.pem
*.key
*.p12

# ── Python (backend) ─────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
backend/dist/
backend/build/

# ── Node / Vite (frontend) ───────────────────────────────────────────────────
node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/coverage/
# Vite's dependency pre-bundling cache.
.vite/
*.tsbuildinfo
*.local

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── OS / IDE ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~

# ── Local scratch in the repository root ─────────────────────────────────────
# Screenshots dropped next to the docs (they may show passwords). Images used by the
# app live under frontend/ and are not affected.
/*.png
/*.jpg
/*.jpeg
/*.webp
