# Copy to backend/.env and fill in. Never commit the real .env.

# dev | prod. In dev the API returns verification tokens in responses and cookies are not
# `Secure` — set APP_ENV=prod on any public stand.
APP_ENV=dev
LOG_LEVEL=INFO

# Special characters in the password must be percent-encoded (! -> %21).
DATABASE_URL=postgresql+asyncpg://fspadmin:change-me@localhost:5432/fsphack
DATABASE_URL_SYNC=postgresql+psycopg://fspadmin:change-me@localhost:5432/fsphack

# At least 32 characters, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
JWT_SECRET=
# 8 hours: the frontend has no refresh flow and keeps the access token.
JWT_ACCESS_TTL_MIN=480
JWT_REFRESH_TTL_DAYS=7

CORS_ORIGINS=http://localhost:5173
# Used in the email verification link and Career Passport links.
PUBLIC_API_URL=http://localhost:8000
PUBLIC_APP_URL=http://localhost:5173

# Required outside dev: registration answers 503 without SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_USE_SSL=false
SMTP_STARTTLS=true

# mock | real
FSP_PROVIDER=mock
FSP_BASE_URL=
FSP_API_TOKEN=
FSP_TIMEOUT_SEC=2

# baseline | ml. With ml, failures fall back to the baseline matcher.
MATCHER_PROVIDER=baseline
ML_MATCHER_URL=
ML_TIMEOUT_SEC=2

PASS_SCORE=70
GRADE_COOLDOWN_DAYS=90
TEST_ATTEMPT_TTL_MIN=30
# Pause before retrying the same or a higher grade after a failure (0 = none).
TEST_RETRY_COOLDOWN_HOURS=24
# A static question leaves rotation after this many shows.
STATIC_ITEM_MAX_EXPOSURES=200
CONSENT_VERSION=2026-10-01

# Per-IP/per-user limits (in-memory). Disable for a demo where everyone shares one NAT IP.
RATE_LIMIT_ENABLED=true
